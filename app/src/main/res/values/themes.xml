<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.FloodMApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <!-- <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item> -->
        <!-- Customize your theme here. -->

        <item name="android:statusBarColor">@android:color/transparent</item>
<!--        <item name="android:windowNoTitle">true</item>-->
<!--        <item name="android:windowTranslucentStatus">true</item>-->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.FloodMApp.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.FloodMApp.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.FloodMApp.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="BasePopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="iconSize"> @dimen/margin_small </item>
        <item name="android:textSize">@dimen/text_large</item>z
        <item name="android:fontFamily">@font/montserrat_regular</item>
    </style>

    <style name="AlertDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <!-- Used for the buttons -->
        <item name="colorAccent">@color/signin_button_blue</item>
        <item name="android:background">@drawable/d_brodor</item>
        <!-- Used for the title and text -->
        <item name="android:textAppearanceSmall">@font/montserrat_regular</item>
        <item name="android:textAppearanceMedium">@font/montserrat_regular</item>
        <item name="android:textAppearanceLarge">@font/montserrat_regular</item>
        <item name="android:fontFamily">@font/montserrat_regular</item>
    </style>
</resources>