<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="10dp"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:layout_toStartOf="@+id/tv_slidingpanel_settings"
                android:layout_centerVertical="true"
                android:src="@drawable/profile_settings"
                />

            <TextView
                android:id="@+id/tv_slidingpanel_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:fontFamily="@font/montserrat_bold"
                android:layout_centerInParent="true"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:layout_toStartOf="@+id/tv_slidingpanel_edit_profile"
                android:layout_centerVertical="true"
                android:src="@drawable/profile_edit"
                />

            <TextView
                android:id="@+id/tv_slidingpanel_edit_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Profile"
                android:fontFamily="@font/montserrat_bold"
                android:layout_centerInParent="true"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                />

        </RelativeLayout>

    </LinearLayout>

</FrameLayout>