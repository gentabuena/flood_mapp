<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".main.views.fragments.ProfileFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >

                <ImageView
                    android:id="@+id/iv_frag_profile_settings"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="15dp"
                    android:layout_marginEnd="20dp"
                    android:src="@drawable/profile_menu" />

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/iv_frag_profile_settings"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="-15dp"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="@string/text_profile"
                    android:textSize="30sp" />

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="25dp"
                android:paddingBottom="25dp"
                >

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/iv_frag_profile_dp"
                    android:layout_width="85dp"
                    android:layout_height="85dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/user_icon" />

            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginBottom="20dp"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="25dp"
                    android:layout_marginEnd="25dp"
                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:text="Email"
                        android:textStyle="bold"
                        android:layout_marginStart="15sp"
                        android:fontFamily="@font/montserrat_regular"
                        />

                    <EditText
                        android:id="@+id/et_frag_profile_email"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_blue_textview_rounded"
                        android:layout_marginTop="5dp"
                        android:text="juandelacruz@gmail.com"
                        android:textSize="15sp"
                        android:textColor="@color/black"
                        android:paddingStart="15sp"
                        android:paddingEnd="15sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:enabled="false"
                        />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="25dp"
                    android:layout_marginEnd="25dp"
                    android:layout_marginTop="15dp"
                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:text="Full Name"
                        android:textStyle="bold"
                        android:layout_marginStart="15sp"
                        android:fontFamily="@font/montserrat_regular"
                        />

                    <EditText
                        android:id="@+id/et_frag_profile_name"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_blue_textview_rounded"
                        android:layout_marginTop="5dp"
                        android:text="Juan Delacruz"
                        android:textSize="15sp"
                        android:textColor="@color/black"
                        android:paddingStart="15sp"
                        android:paddingEnd="15sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:enabled="false"
                        android:maxLines="1"
                        />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="25dp"
                    android:layout_marginEnd="25dp"
                    android:weightSum="1"
                    >

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight=".48"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:text="Age"
                            android:textStyle="bold"
                            android:layout_marginStart="15sp"
                            android:fontFamily="@font/montserrat_regular"
                            />

                        <EditText
                            android:id="@+id/et_frag_profile_age"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_blue_textview_rounded"
                            android:layout_marginTop="5dp"
                            android:text="25"
                            android:textSize="15sp"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:paddingStart="15sp"
                            android:paddingEnd="15sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:enabled="false"
                            android:maxLines="1"
                            android:inputType="number"
                            android:maxLength="2"
                            />

                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:layout_weight=".04"
                        />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight=".48"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:text="Gender"
                            android:textStyle="bold"
                            android:layout_marginStart="15sp"
                            android:fontFamily="@font/montserrat_regular"
                            />

                        <EditText
                            android:id="@+id/et_frag_profile_gender"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_blue_textview_rounded"
                            android:layout_marginTop="5dp"
                            android:text="Male"
                            android:textSize="15sp"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:paddingStart="15sp"
                            android:paddingEnd="15sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:enabled="false"
                            android:maxLines="1"
                            android:visibility="visible"
                            android:inputType=""
                            android:maxLength="8"
                            />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/ti_frag_profile_gender"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_blue_textview_rounded"
                            android:layout_marginTop="5dp"
                            android:textSize="15sp"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:paddingStart="15sp"
                            android:paddingEnd="15sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:enabled="false"
                            android:visibility="gone"
                            android:hint="Select Gender"

                            >

                            <AutoCompleteTextView
                                android:id="@+id/auto_complete_gender"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                />

                        </com.google.android.material.textfield.TextInputLayout>


                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="25dp"
                    android:layout_marginEnd="25dp"
                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:text="Mobile Number"
                        android:textStyle="bold"
                        android:layout_marginStart="15sp"
                        android:fontFamily="@font/montserrat_regular"
                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_blue_textview_rounded"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:text="+63"
                            android:textSize="15sp"
                            android:textColor="@color/black"
                            android:layout_gravity="center"
                            android:fontFamily="@font/montserrat_bold"
                            />

                        <EditText
                            android:id="@+id/et_frag_profile_contact"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@android:color/transparent"
                            android:text="9777838042"
                            android:textSize="15sp"
                            android:textColor="@color/black"
                            android:paddingStart="10sp"
                            android:paddingEnd="15sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:enabled="false"
                            android:maxLines="1"
                            android:maxLength="10"
                            android:inputType="phone"
                            />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="25dp"
                    android:layout_marginEnd="25dp"
                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:text="Full Address"
                        android:textStyle="bold"
                        android:layout_marginStart="15sp"
                        android:fontFamily="@font/montserrat_regular"
                        />

                    <EditText
                        android:id="@+id/et_frag_profile_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_blue_textview_rounded"
                        android:layout_marginTop="5dp"
                        android:text="Monterosas Exe. Village"
                        android:textSize="15sp"
                        android:textColor="@color/black"
                        android:paddingStart="15sp"
                        android:paddingEnd="15sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:enabled="false"
                        android:inputType="textMultiLine"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llt_frag_profile_save"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="25dp"
                    android:layout_marginEnd="25dp"
                    android:visibility="gone"
                    >

                    <TextView
                        android:id="@+id/tv_frag_profile_save"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:text="@string/text_save"
                        android:textAlignment="center"
                        android:fontFamily="@font/montserrat_regular"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:gravity="center"
                        android:textAllCaps="true"
                        android:background="@drawable/bg_rounded_blue"
                        />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>