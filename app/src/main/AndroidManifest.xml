<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.fea.floodmapp">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/final_logo_bbg_hexa_v3"
        android:name=".main.dependencies.MyApp"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/final_logo_bbg_hexa_v3"
        android:supportsRtl="true"
        android:theme="@style/Theme.FloodMApp"
        android:windowSoftInputMode="stateHidden|adjustResize">
        <activity
            android:name=".main.views.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FloodMApp.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".main.views.SignInActivity"
            android:exported="false"
            android:theme="@style/Theme.FloodMApp.NoActionBar"
            />
        <activity
            android:name=".main.views.SigninSignupActivity"
            android:exported="false"
            android:theme="@style/Theme.FloodMApp.NoActionBar"
            />
        <activity
            android:name=".main.views.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FloodMApp.NoActionBar" />
    </application>
</manifest>